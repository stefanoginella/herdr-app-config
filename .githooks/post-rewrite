#!/bin/sh
# A rebase changed the checkout (an amend does not): copy the packaged mods into mods/, which
# Herdr runs. Turned on per clone with `git config core.hooksPath .githooks` (see the README).
[ "$1" = rebase ] || exit 0
cd "$(git rev-parse --show-toplevel)" || exit 0
python3 docs/sync-mods.py || echo "post-rewrite: mods/ was not synced; run python3 docs/sync-mods.py" >&2
exit 0
