# Herdr customizations.
#
# Herdr writes most of this folder itself: its own mods and layouts are replaced on
# every start, and the state files change all the time. So everything is ignored
# unless it is listed here. For a new mod, layout, theme or asset of yours, add a line.

/*

# The repository itself
!/.gitignore
!/README.md
!/RECIPE.md
!/preview.png
!/packages/
/packages/*/*
!/packages/*/RECIPE.md
!/packages/*/preview.png
!/packages/*/keys.json
!/packages/*/mods/
/packages/*/mods/*/*.d.ts
/packages/*/mods/*/jsconfig.json
__pycache__/
!/LICENSE
!/NOTICE

# What you edit
!/keys.json
!/settings.json
!/programs.json

# Notes for coding agents. AGENTS.md itself is Herdr's and rewritten on every start.
!/CLAUDE.md
!/AGENTS.override.md

# The feature pages and their pictures, and the notes on each mod for coding agents
!/docs/
# Finder's own file, in any folder let through above
.DS_Store

# Skills for coding agents (settings files in .claude stay ignored)
!/.claude/
/.claude/*
!/.claude/skills/

# Your layouts (main, terminals and win98 are Herdr's)
!/layouts/
/layouts/*
!/layouts/herdr-powertools.json

# Your mods (the rest are Herdr's)
!/mods/
/mods/*
!/mods/space-folders/
!/mods/mark-agents-unread/
!/mods/file-explorer/
!/mods/file-editor/
!/mods/project-search/
!/mods/git-panel/
!/mods/git-diff/
!/mods/go-to-file/
!/mods/editor-links/
!/mods/agent-usage/
!/mods/tabs-names/
!/mods/pane-names/
!/mods/hide-names/
!/mods/back-and-forward/
!/mods/quick-actions/

# Your themes and assets, once there are some
!/themes/
/themes/*
# !/themes/<name>.json
# !/backgrounds/
# !/fonts/

# Written into every mod folder by the app
/mods/*/gpui-kit.d.ts
/mods/*/jsconfig.json
