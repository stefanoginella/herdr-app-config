+    /// Like x_for_index for a sequence of increasing byte offsets. Guide
+    /// painting visits every indent level of a line, so keep the glyph cursor.
+    pub(crate) fn forward_x_positions(&self) -> impl FnMut(usize) -> Pixels + '_ {
+        let (mut fragment, mut run, mut glyph) = (0, 0, 0);
+        move |ix| {
+            let (line, index, origin) = match &self.content {
+                Content::Text(line) => (line, ix, px(0.)),
+                Content::Inline(parts) => {
+                    while parts.get(fragment).is_some_and(|p| ix >= p.range.end) {
+                        fragment += 1;
+                        run = 0;
+                        glyph = 0;
+                    }
+                    let Some(part) = parts.get(fragment) else { return self.width };
+                    let Some(line) = &part.text else {
+                        return if ix <= part.range.start { part.x } else { part.x + part.width };
+                    };
+                    (line, ix.saturating_sub(part.range.start), part.x)
+                }
+            };
+            while let Some(font_run) = line.runs.get(run) {
+                while let Some(g) = font_run.glyphs.get(glyph) {
+                    if g.index >= index { return origin + g.position.x; }
+                    glyph += 1;
+                }
+                run += 1;
+                glyph = 0;
+            }
+            origin + line.width
+        }
+    }
