+impl LineLayout {
+    // Guide segments use the same shaped rows and hanging indent as text and carets.
+    fn each_indent_guide(
+        &self,
+        step: usize,
+        line_height: Pixels,
+        mut segment: impl FnMut(Pixels, Pixels, Pixels),
+    ) {
+        let height = self.wrapped_lines.len() * line_height;
+        let mut column = 0;
+        'rows: for (i, row) in self.wrapped_lines.iter().enumerate() {
+            let mut x_for_index = row.forward_x_positions();
+            let carry = if i == 0 { px(0.) } else { self.wrap_indent };
+            for (ix, byte) in row.text.bytes().enumerate() {
+                let width = match byte {
+                    b' ' => 1,
+                    b'\t' => step,
+                    _ => break 'rows,
+                };
+                // HERDR: measure the actual shaped glyph, including a guide
+                // partway through a tab following a partial space indent.
+                let within = (step - column % step) % step;
+                column += width;
+                if within >= width {
+                    continue;
+                }
+                let left = x_for_index(ix);
+                let mut x = carry + left;
+                if within > 0 {
+                    x += (x_for_index(ix + 1) - left) * (within as f32 / width as f32);
+                }
+                let top = i * line_height;
+                let bottom = if i == 0 && x < self.wrap_indent {
+                    height
+                } else {
+                    top + line_height
+                };
+                segment(x, top, bottom);
+            }
+        }
     }
+}

